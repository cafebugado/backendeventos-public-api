generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooler :6543 (pgbouncer, transaction mode) — usado em runtime
  directUrl = env("DIRECT_URL") // conexão direta :5432 — usada só por `prisma db pull`/`migrate`
}

/// Escrito à mão a partir de D:\backendeventos\app\models\evento.py (SQLAlchemy) e
/// depois validado campo a campo contra a tabela real via `information_schema.columns`
/// usando DIRECT_URL (2026-08-08) — 2 divergências do modelo SQLAlchemy foram
/// corrigidas (`periodo` é NOT NULL no banco real; `status` é nullable). Um
/// `prisma db pull` completo ainda não roda porque a tabela `audit_log` tem FK para
/// `auth.users` e a role `public_api_readonly` só tem GRANT em `public` por enquanto
/// (proposital — `auth` só é liberado no Sprint 5, ver prisma/setup-readonly-role.sql).
///
/// Nome do model é PascalCase singular (`Evento`), idiomático em Prisma/TS, mapeado
/// para a tabela real `eventos` via @@map. Os CAMPOS continuam snake_case sem
/// tradução (sem @map), pois a resposta HTTP pública também é snake_case.
model Evento {
  id            String   @id @default(uuid()) @db.Uuid
  nome          String   @db.Text
  slug          String   @unique @db.Text
  descricao     String?  @db.Text
  /// "DD/MM/YYYY" — texto livre, decisão deliberada de compatibilidade com dado
  /// legado. NÃO converter para DateTime.
  data_evento   String   @db.Text
  horario       String   @db.Text
  dia_semana    String   @db.Text
  /// CHECK CONSTRAINT no Postgres (não é enum nativo): Matinal | Diurno | Vespertino | Noturno.
  /// Modelar como Prisma enum criaria divergência garantida com `prisma db pull` real.
  /// Confirmado via introspecção real (2026-08-08): NOT NULL e tipo text (não varchar)
  /// — diverge do que o modelo SQLAlchemy sugeria (nullable=True); o banco é a
  /// fonte de verdade.
  periodo       String   @db.Text
  link          String   @db.Text
  imagem        String?  @db.Text
  /// Texto livre apesar do nome — SEM CHECK CONSTRAINT no banco.
  modalidade    String?  @db.Text
  endereco      String?  @db.Text
  cidade        String?  @db.Text
  estado        String?  @db.Text
  /// CHECK CONSTRAINT: rascunho | publicado | arquivado | em_analise | recusado.
  /// Interno de moderação — NUNCA exposto na API pública.
  /// Confirmado via introspecção real (2026-08-08): nullable no banco (diverge do
  /// SQLAlchemy, que declarava nullable=False) — banco é a fonte de verdade.
  status        String?  @default("publicado") @db.Text
  /// Interno de moderação — NUNCA exposto na API pública.
  motivo_recusa String?  @db.Text
  /// FK lógica para auth.users (Supabase Auth), sem constraint física — NUNCA exposto.
  created_by    String?  @db.Uuid
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  updated_at    DateTime @default(now()) @db.Timestamptz(6)
  eventoTags    EventoTag[]
  galeriaAlbum  GaleriaAlbum?

  @@index([data_evento])
  @@index([status])
  @@index([created_by])
  @@map("eventos")
}

/// Escrito à mão a partir de D:\backendeventos\app\models\tag.py (SQLAlchemy) e
/// validado campo a campo contra a tabela real via `information_schema.columns` +
/// `pg_constraint` usando DIRECT_URL (2026-08-09). 2 divergências do modelo
/// SQLAlchemy foram corrigidas: `cor` é nullable no banco real (SQLAlchemy
/// declarava `nullable=False`); existe uma coluna `created_by` (FK para
/// `auth.users`) que não está no modelo SQLAlchemy — campo interno de autoria,
/// NUNCA exposto na API pública, mesmo padrão de `Evento.created_by`.
model Tag {
  id         String      @id @default(uuid()) @db.Uuid
  nome       String      @unique @db.Text
  cor        String?     @default("#2563eb") @db.Text
  created_at DateTime?   @default(now()) @db.Timestamptz(6)
  updated_at DateTime?   @default(now()) @db.Timestamptz(6)
  /// FK lógica para auth.users (Supabase Auth) — NUNCA exposto na API pública.
  created_by String?     @db.Uuid
  eventoTags EventoTag[]

  @@map("tags")
}

/// Escrito à mão a partir de D:\backendeventos\app\models\evento_tag.py
/// (SQLAlchemy), validado do mesmo jeito que `Tag` acima (2026-08-09). 1
/// divergência: `created_at` é nullable no banco real (SQLAlchemy declarava
/// NOT NULL) — tem default `now()`, só não é enforced como NOT NULL.
model EventoTag {
  id         String    @id @default(uuid()) @db.Uuid
  evento_id  String    @db.Uuid
  tag_id     String    @db.Uuid
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  evento     Evento    @relation(fields: [evento_id], references: [id], onDelete: Cascade)
  tag        Tag       @relation(fields: [tag_id], references: [id], onDelete: Cascade)

  @@unique([evento_id, tag_id])
  @@index([evento_id])
  @@index([tag_id])
  @@map("evento_tags")
}

/// Escrito à mão a partir de D:\backendeventos\app\models\contribuinte.py (SQLAlchemy)
/// e validado campo a campo contra a tabela real via `information_schema.columns` +
/// `pg_constraint` usando DIRECT_URL (2026-08-10). 1 divergência do modelo SQLAlchemy
/// foi corrigida: `created_at`/`updated_at` são nullable no banco real (SQLAlchemy
/// declarava `Mapped[datetime]` sem `Optional`) — mesmo tipo de divergência já visto
/// em `EventoTag.created_at`. Sem coluna de "ativo"/"aprovado"/"destaque" — o legado
/// (`ContribuinteRepository.list_all()`) devolve todos os registros sem filtro,
/// ordenado por `nome`; replicado sem alteração aqui.
model Contribuinte {
  id              String    @id @default(uuid()) @db.Uuid
  /// Não exposto na API pública — nenhum consumidor do frontend lê esse campo.
  github_username String    @unique @db.Text
  nome            String    @db.Text
  avatar_url      String    @db.Text
  github_url      String    @db.Text
  linkedin_url    String?   @db.Text
  portfolio_url   String?   @db.Text
  /// Não exposto na API pública.
  created_at      DateTime? @default(now()) @db.Timestamptz(6)
  /// Não exposto na API pública.
  updated_at      DateTime? @default(now()) @db.Timestamptz(6)

  @@map("contribuintes")
}

/// Modelos da Sprint 5 (galeria) — colunas validadas contra a tabela real via
/// `information_schema.columns` + `pg_constraint` usando DIRECT_URL (2026-08-12). FKs
/// físicas reais confirmadas: `galeria_albuns.evento_id → eventos` (SET NULL),
/// `galeria_albuns.comunidade_id → comunidades` (SET NULL), `galeria_fotos.album_id →
/// galeria_albuns` (CASCADE). `created_by`/`uploaded_by`/`comunidades.created_by` também
/// têm FK física real pra `auth.users`, mas não são modeladas como @relation aqui — mesmo
/// tratamento de "FK lógica" já usado em `Evento.created_by`/`Tag.created_by`: resolvidas
/// por nome via `UserProfile`, nunca expostas cruas na API pública.
model GaleriaAlbum {
  id            String        @id @default(uuid()) @db.Uuid
  evento_id     String?       @unique @db.Uuid
  comunidade_id String?       @db.Uuid
  created_by    String?       @db.Uuid
  created_at    DateTime?     @default(now()) @db.Timestamptz(6)
  updated_at    DateTime?     @default(now()) @db.Timestamptz(6)
  evento        Evento?       @relation(fields: [evento_id], references: [id], onDelete: SetNull)
  comunidade    Comunidade?   @relation(fields: [comunidade_id], references: [id], onDelete: SetNull)
  fotos         GaleriaFoto[]

  @@index([comunidade_id])
  @@index([created_by])
  @@map("galeria_albuns")
}

model GaleriaFoto {
  id           String       @id @default(uuid()) @db.Uuid
  album_id     String       @db.Uuid
  url          String       @db.Text
  storage_path String?      @db.Text
  legenda      String?      @db.Text
  ordem        Int?         @default(0)
  uploaded_by  String?      @db.Uuid
  created_at   DateTime?    @default(now()) @db.Timestamptz(6)
  album        GaleriaAlbum @relation(fields: [album_id], references: [id], onDelete: Cascade)

  @@index([album_id])
  @@index([uploaded_by])
  @@map("galeria_fotos")
}

model Comunidade {
  id         String         @id @default(uuid()) @db.Uuid
  nome       String         @db.Text
  created_by String?        @db.Uuid
  created_at DateTime?      @default(now()) @db.Timestamptz(6)
  updated_at DateTime?      @default(now()) @db.Timestamptz(6)
  albuns     GaleriaAlbum[]

  @@map("comunidades")
}

/// Só as 3 colunas realmente lidas pela galeria — a tabela real tem bem mais campos de
/// perfil (github_username, avatar_url, whatsapp, bio, data_nascimento, etc.), nenhum
/// modelado aqui de propósito: reduz superfície exposta e mantém o Prisma Client enxuto.
model UserProfile {
  user_id   String  @id @db.Uuid
  nome      String? @db.Text
  sobrenome String? @db.Text

  @@map("user_profiles")
}
