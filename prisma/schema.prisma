generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooler :6543 (pgbouncer, transaction mode) — usado em runtime
  directUrl = env("DIRECT_URL") // conexão direta :5432 — usada só por `prisma db pull`/`migrate`
}

/// Escrito à mão a partir de D:\backendeventos\app\models\evento.py (SQLAlchemy) e
/// depois validado campo a campo contra a tabela real via `information_schema.columns`
/// usando DIRECT_URL (2026-08-08) — 2 divergências do modelo SQLAlchemy foram
/// corrigidas (`periodo` é NOT NULL no banco real; `status` é nullable). Um
/// `prisma db pull` completo ainda não roda porque a tabela `audit_log` tem FK para
/// `auth.users` e a role `public_api_readonly` só tem GRANT em `public` por enquanto
/// (proposital — `auth` só é liberado no Sprint 5, ver prisma/setup-readonly-role.sql).
///
/// Nome do model é PascalCase singular (`Evento`), idiomático em Prisma/TS, mapeado
/// para a tabela real `eventos` via @@map. Os CAMPOS continuam snake_case sem
/// tradução (sem @map), pois a resposta HTTP pública também é snake_case.
model Evento {
  id            String   @id @default(uuid()) @db.Uuid
  nome          String   @db.Text
  slug          String   @unique @db.Text
  descricao     String?  @db.Text
  /// "DD/MM/YYYY" — texto livre, decisão deliberada de compatibilidade com dado
  /// legado. NÃO converter para DateTime.
  data_evento   String   @db.Text
  horario       String   @db.Text
  dia_semana    String   @db.Text
  /// CHECK CONSTRAINT no Postgres (não é enum nativo): Matinal | Diurno | Vespertino | Noturno.
  /// Modelar como Prisma enum criaria divergência garantida com `prisma db pull` real.
  /// Confirmado via introspecção real (2026-08-08): NOT NULL e tipo text (não varchar)
  /// — diverge do que o modelo SQLAlchemy sugeria (nullable=True); o banco é a
  /// fonte de verdade.
  periodo       String   @db.Text
  link          String   @db.Text
  imagem        String?  @db.Text
  /// Texto livre apesar do nome — SEM CHECK CONSTRAINT no banco.
  modalidade    String?  @db.Text
  endereco      String?  @db.Text
  cidade        String?  @db.Text
  estado        String?  @db.Text
  /// CHECK CONSTRAINT: rascunho | publicado | arquivado | em_analise | recusado.
  /// Interno de moderação — NUNCA exposto na API pública.
  /// Confirmado via introspecção real (2026-08-08): nullable no banco (diverge do
  /// SQLAlchemy, que declarava nullable=False) — banco é a fonte de verdade.
  status        String?  @default("publicado") @db.Text
  /// Interno de moderação — NUNCA exposto na API pública.
  motivo_recusa String?  @db.Text
  /// FK lógica para auth.users (Supabase Auth), sem constraint física — NUNCA exposto.
  created_by    String?  @db.Uuid
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  updated_at    DateTime @default(now()) @db.Timestamptz(6)

  @@index([data_evento])
  @@index([status])
  @@index([created_by])
  @@map("eventos")
}
