# Porta em que a API sobe localmente.
PORT=3000

# Origens do frontend liberadas no CORS, separadas por vírgula (sem espaços extras
# além dos já tratados pelo parser). Inclua o dev do frontend e o domínio de produção.
CORS_ORIGINS=http://localhost:3000,https://agendas-eventos.vercel.app

# --- Banco de dados (Supabase Postgres) ---
# Role dedicada SOMENTE-LEITURA (public_api_readonly) — nunca a mesma credencial
# privilegiada usada pelo D:\backendeventos. Veja o script de criação da role no
# SPRINT.md (tarefa T2).

# Pooler transacional do Supabase (porta 6543) — usado em runtime pela aplicação.
# pgbouncer=true e connection_limit=1 são obrigatórios nesse modo (serverless-friendly).
# NOTA: testado em 2026-08 — o parametro statement_timeout na connection string
# NAO e respeitado pelo pooler (Supavisor/pgbouncer em modo transaction); uma
# query de teste com pg_sleep(10) rodou os 10s inteiros mesmo com
# statement_timeout=5000 na URL. Proteção real exigiria timeout na aplicação
# (ex.: Promise.race no PrismaService) — não implementado nesta sessão.
DATABASE_URL="postgresql://public_api_readonly:senha@aws-1-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Conexão direta ao Postgres (porta 5432) — usada apenas por `prisma db pull`/`migrate`,
# nunca pela aplicação em runtime.
DIRECT_URL="postgresql://public_api_readonly:senha@db.SEU-PROJETO.supabase.co:5432/postgres"
